    <ProjectReference Include="..\HelixAudio.Effects\HelixAudio.Effects.csproj" />
    <ProjectReference Include="..\HelixAudio.Mixing\HelixAudio.Mixing.csproj" />
    <ProjectReference Include="..\HelixAudio.Analysis\HelixAudio.Analysis.csproj" />
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>
</Project>
